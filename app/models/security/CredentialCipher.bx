/**
 * CredentialCipher — application-layer encryption for the credential vault (ADR-0003).
 *
 * Encrypts ONLY secret fields (DB passwords, Pusher secret/appId, socketbox auth) using an
 * AES key supplied via the environment, with a per-record IV. Non-secret columns stay
 * plaintext so the registry remains queryable. This is the single seam to swap for a cloud
 * KMS later — nothing else in the app should call encrypt()/decrypt() directly.
 *
 * Pure with respect to storage: it touches no database. Deterministic given (key, iv).
 */
@singleton
class {

	// Key lives ONLY in the environment (see Coldbox.bx custom settings / .env)
	property name="encryptionKey" inject="coldbox:setting:encryptionKey";

	variables.ALG      = "AES/CBC/PKCS5Padding";
	variables.ENCODING = "base64";

	/**
	 * Whether an encryption key is configured.
	 */
	boolean function isConfigured(){
		return len( trim( variables.encryptionKey ) ) > 0;
	}

	/**
	 * Encrypt a single secret field.
	 *
	 * @plaintext The value to encrypt (empty string yields an empty envelope).
	 *
	 * @return struct { value:<ciphertext>, iv:<base64 iv>, alg:<algorithm> }
	 */
	struct function encryptField( required string plaintext ){
		if ( !len( arguments.plaintext ) ){
			return { "value" : "", "iv" : "", "alg" : "" };
		}
		ensureConfigured();
		var ivBytes = createObject( "java", "java.security.SecureRandom" ).init().generateSeed( 16 );
		var cipher  = encrypt( arguments.plaintext, variables.encryptionKey, variables.ALG, variables.ENCODING, ivBytes );
		return { "value" : cipher, "iv" : binaryEncode( ivBytes, "base64" ), "alg" : variables.ALG };
	}

	/**
	 * Decrypt a single secret field previously produced by encryptField().
	 *
	 * @ciphertext The stored ciphertext.
	 * @iv         The stored base64 IV.
	 * @alg        The stored algorithm (defaults to the current algorithm).
	 */
	string function decryptField( required string ciphertext, required string iv, string alg = variables.ALG ){
		if ( !len( arguments.ciphertext ) ){
			return "";
		}
		ensureConfigured();
		var ivBytes = binaryDecode( arguments.iv, "base64" );
		return decrypt( arguments.ciphertext, variables.encryptionKey, arguments.alg, variables.ENCODING, ivBytes );
	}

	/**
	 * Encrypt a struct of secret fields as a single JSON blob (one per-record IV). Used to store
	 * a Connection's { username, password } or a Broadcast Connection's secrets in one column.
	 *
	 * @secrets Struct of secret name/value pairs.
	 *
	 * @return struct { value, iv, alg } — the encrypted envelope.
	 */
	struct function encryptStruct( required struct secrets ){
		return encryptField( jsonSerialize( arguments.secrets ) );
	}

	/**
	 * Decrypt an envelope produced by encryptStruct() back into a struct.
	 */
	struct function decryptStruct( required string ciphertext, required string iv, string alg = variables.ALG ){
		var json = decryptField( arguments.ciphertext, arguments.iv, arguments.alg );
		return ( len( json ) && isJSON( json ) ) ? jsonDeserialize( json ) : {};
	}

	private void function ensureConfigured(){
		if ( !isConfigured() ){
			throw(
				type    = "cbqm.MissingEncryptionKey",
				message = "CBQM_ENCRYPTION_KEY is not set; cannot encrypt/decrypt credentials."
			);
		}
	}

}
