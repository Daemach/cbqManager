/**
 * UserService — Quick-backed authentication service used by cbauth (PRD Q14).
 * Implements the CBSecurity IUserService surface over the Quick User entity.
 */
@singleton
class {

	@inject( "wirebox" )
	property name="wirebox";

	/**
	 * A new (unloaded) User entity via the WireBox provider.
	 */
	@provider( "User" )
	function new(){
	}

	/**
	 * Verify username/password credentials.
	 */
	boolean function isValidCredentials( required username, required password ){
		var user = userQuery().where( "username", arguments.username ).first();
		if ( isNull( user ) ){
			return false;
		}
		return user.isValidPassword( arguments.password );
	}

	/**
	 * Retrieve a user by username (returns an unloaded User if not found).
	 */
	function retrieveUserByUsername( required username ){
		var user = userQuery().where( "username", arguments.username ).first();
		return isNull( user ) ? new () : user;
	}

	/**
	 * Retrieve a user by id (returns an unloaded User if not found).
	 */
	function retrieveUserById( required id ){
		var user = userQuery().find( arguments.id );
		return isNull( user ) ? new () : user;
	}

	/**
	 * Create a user. The FIRST user becomes the bootstrap `admin`; the rest default to `viewer`.
	 * Population already bcrypt-hashed the password via the entity's setPassword().
	 *
	 * @user A populated (unsaved) User entity.
	 */
	function create( required user ){
		var role = ( userQuery().count() == 0 ) ? "admin" : "viewer";
		arguments.user.setRole( role );
		arguments.user.setIsActive( true );
		arguments.user.save();
		return arguments.user;
	}

	private function userQuery(){
		return variables.wirebox.getInstance( "User" );
	}

}
