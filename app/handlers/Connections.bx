/**
 * Connections — admin CRUD over the encrypted Connection Registry (admin-only; ADR-0003).
 * Never returns secret fields to the client.
 */
class extends="BaseApiHandler" {

	property name="registry" inject="ConnectionRegistry";

	function index( event, rc, prc ){
		if ( !secure( event, "connection.list" ) ) return;
		event.getResponse().setData( registry.list() );
	}

	function show( event, rc, prc ){
		if ( !secure( event, "connection.get" ) ) return;
		var row = registry.get( rc.id );
		// strip secrets before returning
		structDelete( row, "secrets_enc" );
		structDelete( row, "cipherIv" );
		structDelete( row, "cipherAlg" );
		event.getResponse().setData( row );
	}

	/**
	 * Broadcast (realtime) config for a Connection — PUBLIC params only; never the secret.
	 * Connection-scoped read (monitor.view), so scoped operators/viewers can subscribe, not just admins.
	 * Returns { realtime, transport, channel, events, publicParams }; a Connection with no Broadcast
	 * Connection returns a well-formed realtime:false result.
	 */
	function broadcast( event, rc, prc ){
		if ( !secure( event, "monitor.view", rc.connectionId ) ) return;
		event.getResponse().setData( registry.publicBroadcastFor( rc.connectionId ) );
	}

	function create( event, rc, prc ){
		if ( !secure( event, "connection.create" ) ) return;
		var id = registry.create( rc );
		audit( "connection.create", { targetType : "connection", targetId : id } );
		event.getResponse().setData( { "id" : id } );
	}

	function update( event, rc, prc ){
		if ( !secure( event, "connection.update" ) ) return;
		registry.update( rc.id, rc );
		audit( "connection.update", { targetType : "connection", targetId : rc.id } );
		event.getResponse().addMessage( "Connection updated" );
	}

	function remove( event, rc, prc ){
		if ( !secure( event, "connection.delete" ) ) return;
		registry.remove( rc.id );
		audit( "connection.delete", { targetType : "connection", targetId : rc.id } );
		event.getResponse().addMessage( "Connection deleted" );
	}

}
