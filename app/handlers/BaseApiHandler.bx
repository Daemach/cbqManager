/**
 * BaseApiHandler — thin base for cbqManager's REST handlers. Centralizes the current-actor lookup,
 * the RBAC + per-Connection authorization gate (Authorization), and audit logging (AuditLog).
 * Handlers stay shallow: parse params -> secure() -> call a deep module -> set response.
 */
class extends="coldbox.system.RestHandler" {

	property name="authorization" inject="Authorization";
	property name="auditLog"      inject="AuditLog";

	/**
	 * The authenticated actor as { id, role } (defaults to viewer/0 if unresolved).
	 * TODO: align with the persisted User model's role accessor once it replaces the mock.
	 */
	private struct function actor(){
		try {
			var u = jwtAuth().getUser();
			return { "id" : u.getId(), "role" : ( isNull( u.getRole() ) ? "viewer" : u.getRole() ) };
		} catch ( any e ) {
			return { "id" : 0, "role" : "viewer" };
		}
	}

	/**
	 * Authorize an action; on failure sets a 403 response and returns false.
	 * Usage: `if ( !secure( event, "job.reset", rc.connectionId ) ) return;`
	 */
	private boolean function secure( required any event, required string action, numeric connectionId ){
		var ok = isNull( arguments.connectionId )
			? authorization.can( actor(), arguments.action )
			: authorization.can( actor(), arguments.action, arguments.connectionId );
		if ( !ok ){
			arguments.event.getResponse().setError( true ).setStatusCode( 403 ).addMessage( "Forbidden: #arguments.action#" );
		}
		return ok;
	}

	/**
	 * Guard a Connection-scoped read/action against an unreachable target DB (CONTEXT.md "Primary
	 * operator workflow": the console opens BEFORE the VPN, so the production Connection's DB is
	 * briefly unreachable). When the runtime can't open the datasource it throws a BoxRuntimeException
	 * whose message starts with "Unable to create datasource connection ..." — a transient infra
	 * condition, not a bug. We catch ONLY that case and map it to a calm, structured HTTP 503
	 * (`connection_unreachable`) the frontend renders as a retryable banner. Any OTHER exception
	 * re-throws so the normal RestHandler error path (raw 500) still surfaces real bugs.
	 *
	 * Deliberately NOT 401/403 — those trip the global auth redirect (App.vue). Centralized here so
	 * all five Connection-scoped tools (QueueHealth/Jobs/FailedJobs/Batches/Archive) behave identically.
	 *
	 * Usage: `withConnection( event, () => event.getResponse().setData( repo.read( rc.connectionId ) ) )`
	 */
	private function withConnection( required any event, required any fn ){
		try {
			return arguments.fn();
		} catch ( any e ) {
			if ( isConnectionUnreachable( e ) ){
				// Render the exact structured contract the frontend keys on. We renderData() directly
				// (rather than the standard Response packet) so `code` sits at the TOP level of the body
				// — `{ error:true, code:"connection_unreachable", messages:[...] }` — and short-circuit
				// the RestHandler's default render. 503 (Service Unavailable) reads as transient/retry.
				arguments.event.renderData(
					type       = "json",
					statusCode = 503,
					data       = {
						"error"    : true,
						"code"     : "connection_unreachable",
						"messages" : [ "Can't reach this Connection's database — connect the VPN and refresh." ]
					}
				);
				return;
			}
			rethrow;
		}
	}

	/**
	 * True when an exception is the datasource-unreachable condition (target DB not reachable yet).
	 * Pure predicate over the exception message so it is independent of the concrete exception type
	 * the JDBC layer happens to throw. Walks `message` + `detail` since the runtime sometimes wraps
	 * the connect failure ("An exception occurred: Unable to create datasource connection ...").
	 */
	private boolean function isConnectionUnreachable( required any e ){
		var needle = "Unable to create datasource connection";
		var hay    = ( arguments.e.message ?: "" ) & " " & ( arguments.e.detail ?: "" );
		return hay.findNoCase( needle ) > 0;
	}

	/**
	 * Record a mutation against the audit log using the current actor.
	 */
	private function audit( required string action, struct meta = {} ){
		var who = actor();
		auditLog.record( {
			"userId"       : who.id,
			"action"       : arguments.action,
			"connectionId" : arguments.meta.connectionId ?: javacast( "null", "" ),
			"targetType"   : arguments.meta.targetType ?: javacast( "null", "" ),
			"targetId"     : arguments.meta.targetId ?: javacast( "null", "" ),
			"detail"       : arguments.meta.detail ?: javacast( "null", "" ),
			"result"       : arguments.meta.result ?: javacast( "null", "" )
		} );
	}

}
