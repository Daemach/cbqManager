/**
 * Phase 1 — ConnectionRegistry broadcast CRUD, encrypted credential round-trips, the generic
 * datasource shape, and the idempotent/linked dev fixture seeder.
 *
 * These assert EXTERNAL behavior (what goes in encrypted comes back decrypted; the pairing is
 * present; seeding twice does not duplicate) — not how the SQL is built. The live-DB case is
 * opt-in (RUN_LIVE=true) since it needs the real SQL Server target reachable.
 */
@autowire
class extends="coldbox.system.testing.BaseTestCase" {

	@inject( "ConnectionRegistry" )
	property name="registry";

	@inject( "DevFixtureSeeder" )
	property name="seeder";

	@inject( "QueryBuilderFactory" )
	property name="qbFactory";

	function beforeAll(){ super.beforeAll(); }

	// Tear down any rows this spec leaked into the dev own store. The specs create Connections and
	// Broadcast Connections named "TEST_*"; without this they accumulate every `box testbox run`,
	// bloat cbqmanager.db, and push real rows onto later pages in the Connections UI (regression
	// that broke connections-ui.spec.js once 5+ leaked).
	function afterAll(){
		purgeTestRows();
		super.afterAll();
	}

	private function purgeTestRows(){
		var own = variables.qbFactory.forOwnStore();
		own.from( "cbqm_connections" ).where( "name", "like", "TEST_%" ).delete();
		own.from( "cbqm_broadcast_connections" ).where( "name", "like", "TEST_%" ).delete();
	}

	function run(){
		describe( "ConnectionRegistry & dev fixture (Phase 1)", () => {

			beforeEach( ( currentSpec ) => {
				// New ColdBox request per spec.
				setup();
			} );

			it( "createBroadcast encrypts secrets and resolveBroadcast round-trips them", () => {
				var bcName = "TEST_BC_" & getTickCount();
				var id     = registry.createBroadcast( {
					"name"          : bcName,
					"transport"     : "pusher",
					"pusherKey"     : "pk_public",
					"pusherCluster" : "us2",
					"secrets"       : { "pusherAppId" : "appid-123", "pusherSecret" : "shh-secret" }
				} );
				expect( id ).toBeNumeric();
				expect( id ).notToBe( 0 );
				try {
					var resolved = registry.resolveBroadcast( id );
					// Secrets decrypt back to the originals.
					expect( resolved.secrets.pusherSecret ).toBe( "shh-secret" );
					expect( resolved.secrets.pusherAppId ).toBe( "appid-123" );
					// Public fields stay plaintext and queryable.
					expect( resolved.pusherKey ).toBe( "pk_public" );
					// The stored blob is non-empty and does NOT contain the plaintext secret.
					var raw = qbFactory.forOwnStore().from( "cbqm_broadcast_connections" ).where( "id", id ).first();
					expect( len( raw.secrets_enc ) ).toBeGT( 0 );
					expect( raw.secrets_enc ).notToInclude( "shh-secret" );
				} finally {
					registry.removeBroadcast( id );
				}
			} );

			it( "create + resolve a Connection decrypts the datasource using the generic driver", () => {
				var bcId = registry.createBroadcast( { "name" : "TEST_BC2_" & getTickCount(), "transport" : "pusher", "secrets" : {} } );
				var id   = registry.create( {
					"name"                  : "TEST_CONN_" & getTickCount(),
					"environment"           : "development",
					"grammar"               : "mssql",
					"datasourceClass"       : "com.microsoft.sqlserver.jdbc.SQLServerDriver",
					"connectionString"      : "jdbc:sqlserver://localhost:1433;databaseName=X;trustServerCertificate=true",
					"secrets"               : { "username" : "sa", "password" : "p@ssw0rd" },
					"broadcastConnectionId" : bcId,
					"channel"               : "development",
					"events"                : "cbqWorker,cbqWorkerError"
				} );
				try {
					var resolved = registry.resolve( id );
					expect( resolved.datasource.driver ).toBe( "generic" );
					expect( resolved.datasource.class ).toBe( "com.microsoft.sqlserver.jdbc.SQLServerDriver" );
					expect( resolved.datasource.username ).toBe( "sa" );
					expect( resolved.datasource.password ).toBe( "p@ssw0rd" );
					// Fast-fail (#25): a SQL Server URL gets short connect timeouts appended so an
					// unreachable target fails in ~2s instead of hanging the thread pool (#22/#24 OOM).
					expect( resolved.datasource.connectionString ).toInclude( "loginTimeout=2" );
					expect( resolved.datasource.connectionString ).toInclude( "socketTimeout=3000" );
					expect( resolved.datasource.connectionString ).toStartWith( "jdbc:sqlserver://localhost:1433" );
					// Paired: the Connection carries its broadcast link.
					expect( resolved.broadcastConnectionId ).toBe( bcId );
				} finally {
					registry.remove( id );
					registry.removeBroadcast( bcId );
				}
			} );

			it( "fast-fail timeouts: don't override an operator-set value, and skip non-SQL-Server URLs", () => {
				// Operator already set loginTimeout → left as-is (and socketTimeout still appended).
				var id1 = registry.create( {
					"name"             : "TEST_CONN_FF1_" & getTickCount(),
					"datasourceClass"  : "com.microsoft.sqlserver.jdbc.SQLServerDriver",
					"connectionString" : "jdbc:sqlserver://h:1433;loginTimeout=30",
					"secrets"          : {}
				} );
				// A non-SQL-Server URL is returned UNCHANGED (grammar-agnostic — ADR-0005).
				var id2 = registry.create( {
					"name"             : "TEST_CONN_FF2_" & getTickCount(),
					"datasourceClass"  : "org.postgresql.Driver",
					"connectionString" : "jdbc:postgresql://h:5432/db",
					"secrets"          : {}
				} );
				try {
					var cs1 = registry.resolve( id1 ).datasource.connectionString;
					expect( cs1 ).toInclude( "loginTimeout=30" );      // operator value preserved
					expect( cs1 ).notToInclude( "loginTimeout=2" );    // not overridden
					expect( cs1 ).toInclude( "socketTimeout=3000" );   // backstop still added

					var cs2 = registry.resolve( id2 ).datasource.connectionString;
					expect( cs2 ).toBe( "jdbc:postgresql://h:5432/db" ); // untouched
				} finally {
					registry.remove( id1 );
					registry.remove( id2 );
				}
			} );

			it( "the dev fixture seeder is idempotent and links the database/websocket pair", () => {
				// The fixture is seeded on app init; running it again must not duplicate.
				var before  = registry.list().len();
				var summary = seeder.seed();
				var after   = registry.list().len();
				expect( after ).toBe( before, "re-seeding must not create duplicate Connections" );

				var conn = registry.findByName( "FTDIQueue" );
				expect( conn ).notToBeEmpty( "FTDIQueue must exist after seeding" );
				expect( conn.broadcastConnectionId ).notToBeEmpty( "Connection must be linked to a Broadcast (paired)" );
				expect( conn.broadcastConnectionId ).toBe( summary.broadcastId );
			} );

			it(
				title = "connects to the live FTDIQueue and reads cbq_jobs",
				skip  = !runLive(),
				body  = () => {
					var conn     = registry.findByName( "FTDIQueue" );
					expect( conn ).notToBeEmpty( "FTDIQueue must be seeded" );
					var resolved = registry.resolve( conn.id );
					var qb       = qbFactory.forConnection( resolved );
					var n        = qb.from( "cbq_jobs" ).count();
					expect( n ).toBeGT( 0, "live cbq_jobs should return rows" );
				}
			);

		} );
	}

	private boolean function runLive(){
		return getSystemSetting( "RUN_LIVE", "false" ) == "true";
	}

}
