/**
 * User — Quick ORM entity with bcrypt password hashing. Built via WireBox (Quick entities need
 * their injected deps), exercising in-memory behavior only (no save / no DB writes).
 */
class extends="coldbox.system.testing.BaseTestCase" {

	function beforeAll(){
		super.beforeAll();
	}

	function afterAll(){
		super.afterAll();
	}

	function run(){
		describe( "A User (Quick entity)", () => {
			beforeEach( ( currentSpec ) => {
				setup();
				variables.model = getInstance( "User" );
			} );

			it( "can be created via WireBox", () => {
				expect( model ).toBeComponent();
			} );

			it( "bcrypt-hashes the password on assignment and verifies it", () => {
				model.setPassword( "secret123" );
				expect( model.getPassword() ).notToBe( "secret123" );      // stored as a hash
				expect( model.isValidPassword( "secret123" ) ).toBeTrue();
				expect( model.isValidPassword( "nope" ) ).toBeFalse();
			} );

			it( "surfaces the single role as a roles array", () => {
				model.setRole( "operator" );
				expect( model.getRoles() ).toBe( [ "operator" ] );
			} );

			it( "defaults roles to viewer when unset", () => {
				expect( model.getRoles() ).toBe( [ "viewer" ] );
			} );

			it( "never exposes the password in its memento", () => {
				model.setUsername( "someone" );
				model.setPassword( "secret123" );
				expect( model.getMemento() ).notToHaveKey( "password" );
			} );
		} );
	}

}
