/**
 * UserService — DB-backed (Quick + bcrypt) against the seeded default admin (admin/password, id 1).
 * These exercise read/verify paths only (no writes), so they need no test-isolation.
 */
class extends="coldbox.system.testing.BaseTestCase" {

	function beforeAll(){
		super.beforeAll();
	}

	function afterAll(){
		super.afterAll();
	}

	function run(){
		describe( "UserService (Quick + bcrypt)", () => {
			beforeEach( ( currentSpec ) => {
				setup();
				variables.model = getInstance( "UserService" );
			} );

			it( "can be created", () => {
				expect( model ).toBeComponent();
			} );

			it( "retrieves the seeded admin by id", () => {
				var oUser = model.retrieveUserById( 1 );
				expect( oUser.isLoaded() ).toBeTrue();
				expect( oUser.getUsername() ).toBe( "admin" );
			} );

			it( "returns an unloaded user for an unknown id", () => {
				var oUser = model.retrieveUserById( 999999 );
				expect( oUser.isLoaded() ).toBeFalse();
			} );

			it( "retrieves the seeded admin by username", () => {
				var oUser = model.retrieveUserByUsername( "admin" );
				expect( oUser.isLoaded() ).toBeTrue();
				expect( oUser.getRole() ).toBe( "admin" );
			} );

			it( "returns an unloaded user for an unknown username", () => {
				var oUser = model.retrieveUserByUsername( "nobody@nowhere" );
				expect( oUser.isLoaded() ).toBeFalse();
			} );

			it( "validates correct credentials via bcrypt", () => {
				expect( model.isValidCredentials( "admin", "password" ) ).toBeTrue();
			} );

			it( "rejects incorrect credentials", () => {
				expect( model.isValidCredentials( "admin", "wrong" ) ).toBeFalse();
				expect( model.isValidCredentials( "nobody", "x" ) ).toBeFalse();
			} );
		} );
	}

}
