# ColdBox Name and Environment
APPNAME=cbqManager
ENVIRONMENT=development

# BoxLang Environment
BOXLANG_DEBUG=true

# ---------------------------------------------------------------------------
# cbqManager OWN store (ADR-0005): SQLite by default, swap to MSSQL via these.
# ---------------------------------------------------------------------------
CBQM_DB_CLASS=org.sqlite.JDBC
CBQM_DB_CONNECTIONSTRING=jdbc:sqlite:./resources/db/cbqmanager.db
CBQM_DB_USER=
CBQM_DB_PASSWORD=
# Example MSSQL override:
# CBQM_DB_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
# CBQM_DB_CONNECTIONSTRING=jdbc:sqlserver://127.0.0.1:1433;databaseName=cbqManager;encrypt=true;trustServerCertificate=true

# ---------------------------------------------------------------------------
# Credential vault encryption (ADR-0003). Generate a 256-bit base64 key.
# BoxLang: generateSecretKey( "AES", 256 )
# ---------------------------------------------------------------------------
CBQM_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Harvester / Archive (ADR-0004)
# ---------------------------------------------------------------------------
# The Harvester writes Archive snapshots to the own store on an interval. Left UNSET, it defaults
# ON: with WAL + busy_timeout (set on the own-store datasource in Application.bx), a LOCAL-disk
# SQLite store tolerates the background writer, and MSSQL handles concurrency natively. Set to
# false only if you must host the SQLite own store on a network/SMB share, where WAL is unavailable
# and a background writer gives spurious "database is locked".
# CBQM_HARVEST_ENABLED=false
# Default harvest interval (seconds) — must be shorter than each target's cbq cleanup window
CBQM_HARVEST_INTERVAL=60
# Default Archive retention (days)
CBQM_ARCHIVE_RETENTION_DAYS=180

# JWT Information
JWT_SECRET=

# S3 Information
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_DOMAIN=amazonaws.com

# ---------------------------------------------------------------------------
# DEV FIXTURE — a real "development" cbq target + Pusher broadcast, used by the
# dev seeder and connection E2E specs. Fill with your local values in .env.
# ---------------------------------------------------------------------------

# Pusher broadcast (development channel)
PUSHER_KEY=
PUSHER_CLUSTER=
PUSHER_APPID=
PUSHER_APISECRET=

# FTDIQueue — local dev cbq database (SQL Server)
FTDI_QUEUE_DB_DATASOURCE_NAME=FTDIQueue
FTDI_QUEUE_DB_HOST=
FTDI_QUEUE_DB_USER=
FTDI_QUEUE_DB_PASSWORD=
